# Copy this file to .env.docker and adjust values before running:
#   docker compose --env-file .env.docker up -d --build
#
# Then seed the platform super-admin once:
#   docker compose --env-file .env.docker --profile seed run --rm seed

# ---------------------------------------------------------------------------
# Postgres (used by the local `postgres` service)
# ---------------------------------------------------------------------------
POSTGRES_USER=fund
POSTGRES_PASSWORD=fund
POSTGRES_DB=fund
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_PORT=3000
# Point this at the in-compose Postgres (default) or at Supabase/another DB.
DATABASE_URL=postgresql://fund:fund@postgres:5432/fund?schema=public
# Must be ≥ 16 chars (env.validation.ts). Change for any non-throwaway use!
JWT_SECRET=please-change-me-to-a-32-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Used as the CORS origin and as the public link prefix in emails.
WEB_APP_URL=http://localhost:8080
TOTP_ISSUER=Фонд-платформа
MAIL_FROM_ADDRESS=no-reply@fund.local

# ---------------------------------------------------------------------------
# Web (build-time — VITE_API_URL is baked into the bundle)
# ---------------------------------------------------------------------------
WEB_PORT=8080
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mailpit (development mail catcher; UI at http://localhost:8025)
# ---------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Seed (one-shot — required only by `docker compose --profile seed run seed`)
# ---------------------------------------------------------------------------
PLATFORM_ADMIN_NAME=Super Admin
PLATFORM_ADMIN_EMAIL=root@platform.local
PLATFORM_ADMIN_PASSWORD=please-change-me-to-a-strong-password
