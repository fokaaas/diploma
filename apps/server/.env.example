# Prisma database connection (Prisma Postgres dev URL, Docker postgres URL, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/funds?schema=public"

PORT=3000
# Base URL of the SPA — used to build invitation / password-reset links in emails.
WEB_APP_URL="http://localhost:5173"

# Access-token signing secret (min 16 chars) + token lifetimes.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Platform super-admin seeded by `pnpm --filter server seed`.
PLATFORM_ADMIN_NAME="Platform Root"
PLATFORM_ADMIN_EMAIL="root@platform.local"
PLATFORM_ADMIN_PASSWORD="change-me"

# SMTP — optional. When MAIL_HOST is unset, emails are logged to the server console.
# The From display name is set per-message to the foundation name; this is just the address.
MAIL_HOST=""
MAIL_USER=""
MAIL_PASS=""
